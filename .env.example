# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_VECTOR_STORE_ID=vs_...

# GoHighLevel MCP server
GHL_MCP_AUTH_TOKEN=...

# GHL location / sub-account ID. Injected into every (non-continuation) request
# so the assistant doesn't have to ask which sub-account to query.
# Find it under: app.gohighlevel.com/v2/location/<this-id>/...
FSR_GHL_LOCATION_ID=...

# Basic auth gate for the entire app (required)
# Pick a non-trivial username and a long password.
APP_USERNAME=fsr
# Wrap in single quotes if the password contains $, `, or other shell-special chars.
APP_PASSWORD='change-me-to-a-long-random-string'
